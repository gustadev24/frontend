---
import Layout from '@/modules/core/layouts/Layout.astro';
import Section from '@/modules/core/ui/section.astro';
import { CoursesTable } from '@/modules/courses/admin/components/CoursesTable';
import { CoursesForm } from '@/modules/courses/admin/components/CoursesForm';
import Title from '@/modules/core/ui/title.astro';
---
<Layout>
  <header class="flex flex-col gap-2">
    <Title>Course Management</Title>
    <h3 class="text-xl text-gray-500">Manage existing courses and create new ones</h3>
  </header>
  <Section title="Existing courses">
    <CoursesTable client:only="react">
      <div slot="fallback" class="bg-gray-300 w-full h-36 animate-pulse">
      </div>
    </CoursesTable>
  </Section>
  <Section title="Create/Edit Course">
    <CoursesForm client:only="react" />
  </Section>
</Layout>
