---
import LayoutTeacher from '@/modules/core/layouts/LayoutTeacher.astro';
import HeaderTeacherDashboard from '@/modules/core/components/HeaderTeacherDashboard.astro';
import { getOneCourse } from '@/modules/courses/lib/useCourses';
import Section from '@/modules/core/ui/section.astro';
import { ModulesTable } from '@/modules/courses/admin/components/ModulesTable';
import { getUser } from '@/modules/auth/lib/authServer';

export const prerender = false;

const user = await getUser();

if (!user) {
  return Astro.redirect('/auth/login');
}

const { course_id } = Astro.params;

if (!course_id) {
  return Astro.redirect('/teacher/courses');
}

const course = await getOneCourse({ courseId: course_id });
---
<LayoutTeacher user={user}>
  <HeaderTeacherDashboard title={course.title} subtitle="Manage modules for this course" />
  <Section title="Modules">
    <ModulesTable modules={course.modules} client:load />
  </Section>
</LayoutTeacher>
