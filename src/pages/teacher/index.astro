---
import Grades from '@/modules/courses/components/Grades';
import Section from '@/modules/core/ui/section.astro';
import H1 from '@/modules/core/ui/h1.astro';
import LayoutTeacher from '@/modules/core/layouts/LayoutTeacher.astro';
import CourseOverview from '@/modules/courses/components/CourseOverview';
import Reports from '@/modules/courses/components/Reports';
---

<LayoutTeacher>
  <H1>
    Teacher Dashboard
  </H1>
  <Section title="Course Overview">
    <CourseOverview client:load/>
  </Section>
  <Section title="Student Progress">
    <Grades client:visible/>
  </Section>
  <Section title="Reports">
    <Reports client:visible/>
  </Section>
</LayoutTeacher>
