---
import '@/styles/global.css';
import '@fontsource-variable/lexend';
import Header from '@/modules/core/layouts/header.astro';
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>StudyCentral</title>
	</head>
	<body class="m-auto max-w-7xl">
	  <Header />
		<main class="flex flex-col pb-20 items-center">
		  <slot />
		</main>
	</body>
</html>

<style>
	html,
	body {
    width: 100%;
		height: 100%;
	}
</style>
