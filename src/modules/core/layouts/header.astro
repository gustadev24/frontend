---
import { IconWifi } from '@tabler/icons-react';
import { IconBell } from '@tabler/icons-react';
---
<div class="w-full flex justify-center sticky top-0 z-50 bg-background">
  <header class="flex items-center justify-between py-4 w-full max-w-7xl">
    <div class="gap-2 font-bold text-lg flex">
      <IconWifi size={24}/>
      <span>StudyCentral</span>
    </div>
    <nav class="text-sm flex gap-9 font-medium items-center">
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <button class="rounded-full bg-zinc-300 w-9 aspect-square flex items-center justify-center hover:bg-zinc-400/50 transition-colors">
          <IconBell size={18} stroke={2}/>
        </button>
        <button class="rounded-full bg-zinc-300 hover:bg-zinc-400/50 transition-colors w-9 aspect-square">
          <span class="sr-only">profile icon</span>
        </button>
    </nav>
  </header>
</div>
