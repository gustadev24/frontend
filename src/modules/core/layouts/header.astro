---
import { IconWifi } from '@tabler/icons-react';
import { IconBell } from '@tabler/icons-react';

import HeaderAuth from '@/modules/auth/components/headerAuth';
import { routesConfig } from '@/modules/core/config/routes';
---
<header class="flex justify-between sticky top-0 z-50 bg-background py-2 md:py-4 px-4 sm:px-6 md:px-8" transition:persist>
  <a href="/" class="gap-2 font-bold text-lg flex">
    <IconWifi size={24}/>
    <span>StudyCentral</span>
  </a>
  <nav class="text-sm flex gap-9 font-medium items-center">
    {
      routesConfig.studentRoutes.map((route) => (
        <a
          href={route.path}
          class="hover:text-primary transition-colors duration-75"
          aria-label={route.name}
        >
          {route.name}
        </a>
      ))
    }
    <button class="rounded-full bg-zinc-300 w-9 aspect-square flex items-center justify-center hover:bg-zinc-400/50 transition-colors">
      <IconBell size={18} stroke={2}/>
    </button>
    <div class="min-w-30">
      <HeaderAuth client:only="react" />
    </div>
  </nav>
</header>
