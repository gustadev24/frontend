---
import { IconBookFilled, IconBook, IconHome, IconHomeFilled, IconMessageReport, IconUser, IconUserFilled, IconMessageReportFilled } from '@tabler/icons-react';

const NAVBAR = [
  {
    icon: IconHome,
    iconSelect: IconHomeFilled,
    label: 'Dashboard',
    href: '/teacher'
  },
  {
    icon: IconBook,
    iconSelect: IconBookFilled,
    label: 'Courses',
    href: '/courses'
  },
  {
    icon: IconUser,
    iconSelect: IconUserFilled,
    label: 'Students',
    href: '/students'
  },
  {
    icon: IconMessageReport,
    iconSelect: IconMessageReportFilled,
    label: 'Reports',
    href: '/reports'
  }
];

const currentPath = Astro.url.pathname;

---

<aside class="w-full max-w-2xs border-border border-r px-4 py-10 sticky top-0 bg-background gap-6 flex flex-col">
  <div class="flex items-start gap-3 px-3">
    <button class="rounded-full aspect-square bg-zinc-300 w-9">
      <span class="sr-only">Personal photo</span>
    </button>
    <div class="flex flex-col gap-1">
      <span class="font-medium">Ms. Harper</span>
      <span class="text-sm">Teacher</span>
    </div>
  </div>
  <nav class="flex flex-col gap-1">
    {NAVBAR.map((item) => (
      <a href={item.href} class="group flex items-center gap-2 px-6 py-3 hover:bg-secondary rounded-full transition-colors duration-75">
        {
          currentPath === item.href
            ? <item.iconSelect size={24} />
            : <item.icon size={24} />
        }
        <span>{item.label}</span>
      </a>
    ))}
  </nav>
</aside>

<scrypt>

</scrypt>
