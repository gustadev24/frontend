{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", ".astro/actions.d.ts" , "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  }
}
